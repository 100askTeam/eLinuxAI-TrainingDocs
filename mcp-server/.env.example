# MCP 服务监听地址。部署到容器或服务器时通常改为 0.0.0.0。
MCP_HOST=127.0.0.1
MCP_PORT=3100
MCP_PATH=/mcp

# 公网部署时填写允许访问该服务的域名，多个域名用英文逗号分隔。
# 如果 MCP_HOST=0.0.0.0 或 ::，此项必填。
MCP_ALLOWED_HOSTS=mcp.example.com

# 可选。浏览器客户端的 Origin 域名白名单；默认沿用 MCP_ALLOWED_HOSTS。
# MCP_ALLOWED_ORIGINS=docs.example.com

# 可选。设置后，客户端必须发送 Authorization: Bearer <key>。
MCP_API_KEY=

# 可选。默认读取仓库根目录的 docs 文件夹。
# MCP_DOCS_ROOT=D:\Programmers\Canaan-Docs\eLinuxAI\eLinuxAI-TrainingDocs\docs

# 搜索结果中生成的线上文档地址。
DOCS_PUBLIC_BASE_URL=https://eai.100ask.net

# 自动检查文档变更的间隔（毫秒）。
MCP_INDEX_REFRESH_MS=30000
